# Customer Success Cloudflare R2 Backend Configuration
# Supply credentials through AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY instead
# of this file; Terraform caches backend arguments in local metadata and plans.
#
# Prefer AWS_ENDPOINT_URL_S3 and AWS_REGION=auto, then run:
# terraform init -reconfigure

# If an endpoint backend argument is unavoidable, this file may contain only the
# non-secret endpoint. Keep credentials in the environment.
endpoints = {
  s3 = "https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"
}
